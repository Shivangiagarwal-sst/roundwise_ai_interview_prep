{
  "name": "roundwise-server",
  "version": "1.0.0",
  "description": "Roundwise API server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand --coverage",
    "lint": "eslint src --max-warnings=0",
    "import:data": "node scripts/importData.js",
    "verify:data": "node scripts/verifyData.js",
    "seed:demo": "node scripts/seedDemo.js",
    "check:ai": "node scripts/checkAi.js",
    "cleanup:legacy-revisions": "node scripts/clearLegacyRevisionSchedules.js"
  },
  "dependencies": {
    "@google/genai": "1.3.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "29.5.14",
    "eslint": "^10.13.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
