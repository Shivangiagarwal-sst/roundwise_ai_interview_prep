# Copy this file to .env and fill in your values
# cp .env.example .env

NODE_ENV=development
PORT=5000

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/roundwise

# JWT secret — must be at least 32 characters (required)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Frontend URL for CORS (comma-separated if multiple, e.g. https://roundwise.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Optional: Set to true if frontend and backend are hosted on different HTTPS domains (e.g. Vercel + Render)
CROSS_SITE_COOKIES=false

# Google Gemini API key (optional — AI features disabled without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Demo account (optional)
DEMO_EMAIL=demo@roundwise.dev
DEMO_PASSWORD=your-demo-password
