# Roundwise Client Environment Variables

# Optional: API Base URL
# - If frontend and backend are deployed together (e.g. Render fullstack), leave this EMPTY.
# - If frontend is deployed separately (e.g. on Vercel / Netlify), set this to your backend URL:
#   Example: VITE_API_URL=https://roundwise-api.onrender.com
VITE_API_URL=
